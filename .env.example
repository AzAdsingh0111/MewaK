# =============================================================================
# MewaK Platform - Environment Configuration
# =============================================================================

# Slack Integration (Incoming Webhook URL)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# Backend API Configuration
API_BASE_URL=http://localhost:8000

# PostgreSQL Database Configuration
POSTGRES_DB=mewak_db
POSTGRES_USER=mewak_user
POSTGRES_PASSWORD=mewak_secure_password_2026
DATABASE_URL=postgresql://mewak_user:mewak_secure_password_2026@postgres:5432/mewak_db

# Email / SMTP Report Delivery Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reports@mewak.com
SMTP_PASSWORD=your_app_password
RECIPIENT_EMAIL=admin@mewak.com
